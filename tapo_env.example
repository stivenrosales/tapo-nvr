# Copy to ~/.tapo_env on the tablet (chmod 600). Never commit the real file.
CAM_IP=192.168.1.206
CAM_USER=change-me
CAM_PASS=change-me

# --- Optional tunables (defaults shown) ---
# Detection (stream2, low-res)
#SCENE=0.005        # per-frame scene-score threshold (use ./tapo-watch.sh --calibrar)
#MIN_HITS=4         # detections required...
#WINDOW=3           # ...within this many seconds of STREAM time (pts_time)
#DEBOUNCE=40        # min wall-clock seconds between triggers

# Clip (stream1, 2K)
#PREROLL_SECS=5     # seconds before the trigger, taken from the ring buffer
#CLIP_SECS=30       # seconds after the trigger

# Ring buffer
#SEG_SECS=5         # segment length
#RING_SECS=120      # segments older than this are pruned (bounds disk usage)
#RING_WAIT_SECS=20  # max wait for the last segment to close (default SEG_SECS*3+5)

# Storage
#RETENTION_DAYS=60  # Drive purge horizon
#REMOTE=drive-tapo:Camara
#WORKDIR=$HOME/tapo

# Extension point: executable called as "$GATE_CMD <clip.mp4>" before upload.
# exit 0 = upload, 1 = discard, anything else = hold in $WORKDIR/held/
#GATE_CMD=$HOME/tapo-nvr/gate/detect.py   # bundled person/vehicle-in-motion detector
# Gate tunables (see README): GATE_MODEL GATE_FRAMES=8 GATE_THREADS=4
#   GATE_CLASSES=person,bicycle,car,motorcycle,bus,truck GATE_CONF=0.4
#   GATE_MOTION_FRAC=0.15 GATE_DIFF_THRESH=25

# --- Monitoring (termux/housekeeper.sh; see README) ---
# healthchecks.io ping URL (secret: keep it only in this file). Unset = no heartbeat.
#HC_URL=https://hc-ping.com/your-check-uuid
#HB_MAX_SEG_AGE=60   # newest ring segment must be younger than this (s) to be "healthy"
#HB_EVERY=300        # heartbeat period (s); match the check's Period in healthchecks.io
#SUMMARY_AT=20:55    # local time from which the daily summary is sent (once per day)
